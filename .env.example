# TruthLens AI - Full Stack Environment Configuration Template
# Copy this file to .env and configure appropriate values before running.

# ==============================================================================
# FRONTEND CONFIGURATION (Vite Client-side)
# ==============================================================================
# Backend REST API endpoint URL
VITE_API_URL=http://127.0.0.1:8000/api

# Supabase Project Credentials (Safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# BACKEND CONFIGURATION (FastAPI Server-side)
# ==============================================================================
ENVIRONMENT=production

# Supabase PostgreSQL Database Connection URL (Use port 6543 pooler with ?pgbouncer=true for serverless)
DATABASE_URL=postgresql+psycopg2://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Auth JWT Secret (Project Settings -> API -> JWT Secret) - STRICTLY SERVER-SIDE
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Production Frontend URL / CORS Allowed Origins (Comma-separated)
FRONTEND_URL=https://your-frontend-deployment.vercel.app
CORS_ORIGINS=https://your-frontend-deployment.vercel.app

# Rate Limits (format: <count>/<second|minute|hour|day>)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_UPLOAD=10/minute

# Google Fact Check Tools API Key (Backend-only)
GOOGLE_FACTCHECK_API_KEY=

