# TruthLens AI - Backend Environment Configuration Template
# Copy this file to .env and configure appropriate values before running.

# Environment Mode: development | production | testing
ENVIRONMENT=production

# Supabase PostgreSQL Connection URL (Use port 6543 pooler with ?pgbouncer=true for serverless/PaaS)
DATABASE_URL=postgresql+psycopg2://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Auth JWT Secret (Found in Supabase Dashboard: Project Settings -> API -> JWT Secret)
# STRICTLY SERVER-SIDE. NEVER EXPOSE TO FRONTEND.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Production Frontend URL / CORS Allowed Origins (Comma-separated)
FRONTEND_URL=https://your-frontend-deployment.vercel.app
CORS_ORIGINS=https://your-frontend-deployment.vercel.app

# Optional: Legacy/Fallback JWT signing key
SECRET_KEY=your_strong_random_secret_key_here

# Rate Limits (format: <count>/<second|minute|hour|day>)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_UPLOAD=10/minute

# Google Fact Check Tools API Key (Backend-only)
GOOGLE_FACTCHECK_API_KEY=

